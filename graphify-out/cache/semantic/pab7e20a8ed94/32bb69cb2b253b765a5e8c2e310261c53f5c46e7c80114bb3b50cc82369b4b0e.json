{"nodes": [{"id": "readme_vi_injel_framework", "label": "Injel Framework (Vietnamese Documentation)", "file_type": "document", "source_file": "README.vi.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Ph\u1ea1m Tr\u01b0\u01a1ng Th\u00f4ng (TogPam)"}, {"id": "readme_vi_gova_tertex_name_history", "label": "Historical Names: GoVa and Tertex", "file_type": "rationale", "source_file": "README.vi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "The project was previously known as GoVa and Tertex in early survey documents. The official product name is Injel; historical documents may retain old names."}, {"id": "readme_vi_fail_fast_principle", "label": "Fail-Fast Design Principle", "file_type": "rationale", "source_file": "README.vi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Duplicate providers, missing dependencies, cycles, and route conflicts are detected before the application serves any request, making errors immediately visible rather than discovered in production."}, {"id": "readme_vi_no_implicit_scanning", "label": "No Implicit Package Scanning Principle", "file_type": "rationale", "source_file": "README.vi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "No package scanning, no global container, no annotation simulation. Flow is explicit and auditable, reducing magic and improving debuggability."}], "edges": [{"source": "readme_vi_injel_framework", "target": "readme_vi_gova_tertex_name_history", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.vi.md", "source_location": "L9", "weight": 1.0}, {"source": "readme_vi_injel_framework", "target": "readme_vi_fail_fast_principle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.vi.md", "source_location": "L29", "wei