{"nodes": [{"id": "docs_adr_0007_database_integration_adr0007", "label": "ADR 0007 \u2014 Database Integration (database/sql)", "file_type": "document", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": "Ph\u1ea1m Tr\u01b0\u01a1ng Th\u00f4ng (@TogPam)"}, {"id": "docs_adr_0007_database_integration_option_gorm_ent", "label": "ADR Option A: GORM or Ent ORM Integration", "file_type": "rationale", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Rejected: adds heavy external dependency to core framework, violates 'small core, separate modules' principle, locks users into ORM model conventions, and is hard to remove once integrated."}, {"id": "docs_adr_0007_database_integration_option_custom_wrapper", "label": "ADR Option B: Custom database/sql Wrapper", "file_type": "rationale", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Rejected: forces users to learn a new API instead of standard *sql.DB, breaks compatibility with sql-ecosystem libraries (sqlx, squirrel, bun), and adds unnecessary abstraction."}, {"id": "docs_adr_0007_database_integration_option_direct_sql", "label": "ADR Option C: Direct database/sql Integration (Chosen)", "file_type": "rationale", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Chosen because database/sql is a standard library adding no dependency; *sql.DB is familiar to all Go developers; users choose their own driver; naturally compatible with the entire Go SQL ecosystem; core framework remains driver-agnostic."}, {"id": "docs_adr_0007_database_integration_database_provide", "label": "database.Provide() \u2014 DI Registration API", "file_type": "concept", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Single entry-point API: validates config, calls sql.Open, configures connection pool, registers *sql.DB singleton provider into DI container, and registers lifecycle hooks \u2014 ensuring consistent setup across all applications."}, {"id": "docs_adr_0007_database_integration_startup_health_check", "label": "Database Startup Health Check (PingContext)", "file_type": "concept", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Pinging the database during OnStart with a configurable timeout ensures the application fails fast if the database is unreachable, preventing a partially-initialized service from receiving traffic."}, {"id": "docs_adr_0007_database_integration_graceful_shutdown", "label": "Database Graceful Shutdown (db.Close)", "file_type": "concept", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Idempotent db.Close() called in LIFO order during OnStop ensures connection pool is cleanly drained without goroutine leaks or double-close panics."}, {"id": "docs_adr_0007_database_integration_connection_pool", "label": "Connection Pool Configuration", "file_type": "concept", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null}, {"id": "docs_adr_0007_database_integration_driver_managed_by_user", "label": "User-Managed Driver Policy", "file_type": "rationale", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Injel does not import any database driver into go.mod. Users import their chosen driver (pq, go-sql-driver/mysql, go-sqlite3, etc.) in application code, keeping go.mod lean, avoiding license conflicts (some drivers have CGO or proprietary licenses), and giving users full control over driver versions."}, {"id": "docs_adr_0007_database_integration_dsn_security", "label": "DSN/Password Security in Error Messages", "file_type": "rationale", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "DSN/password never appears in error messages or log output, preventing credential leakage through error logging pipelines."}, {"id": "docs_adr_0007_database_integration_future_named_providers", "label": "Future: Named Database Providers", "file_type": "rationale", "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "rationale": "Named database providers (e.g., primary + replica) are deferred until the DI container supports named bindings. Currently only one *sql.DB singleton is supported per application context."}], "edges": [{"source": "docs_adr_0007_database_integration_adr0007", "target": "readme_database_integration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-database-integration.md", "source_location": "L1-L7", "weight": 1.0}, {"source": "docs_adr_0007_database_integration_adr0007", "target": "docs_adr_0007_database_integration_option_gorm_ent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-database-integration.md", "source_location": "L26-L34", "weight": 1.0}, {"source": "docs_adr_0007_database_integration_adr0007", "target": "docs_adr_0007_database_integration_option_custom_wrapper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-database-integration.md", "source_location": "L36-L43", "weight": 1.0}, {"source": "docs_adr_