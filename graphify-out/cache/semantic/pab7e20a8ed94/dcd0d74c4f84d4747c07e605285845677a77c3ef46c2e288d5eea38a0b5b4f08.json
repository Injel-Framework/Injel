-database-integration.md", "source_location": "L115-L125", "weight": 1.0}, {"source": "docs_adr_0007_database_integration_startup_health_check", "target": "readme_vi_fail_fast_principle", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/adr/0007-database-integration.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "database_di_lifecycle_integration", "label": "Database Integration with DI Container and Application Lifecycle", "nodes": ["docs_adr_0007_database_integration_database_provide", "readme_ioc_di_engine", "docs_adr_0007_database_integration_startup_health_check", "docs_adr_0007_database_integration_graceful_shutdown", "readme_application_lifecycle"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0007-database-integration.md"}]}